# LeadForge — developer stack configuration.
#
# Everything here has a working default, so `docker compose up --build` runs with NO .env
# at all. Copy this file to `.env` only when you want to change something:
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit a real key — the live values live on the server and
# in Modal Secrets, and the repository only ever names the variables.

# --- Ports ---------------------------------------------------------------------------
# Change these if 3000/8000 are taken. NEXT_PUBLIC_API_BASE below follows API_PORT.
WEB_PORT=3000
API_PORT=8000

# --- Model provider ------------------------------------------------------------------
# stub | modal | openai_compatible
#
# `stub` is the default and needs no GPU, no network and no credentials: a deterministic
# fake extraction is derived from each upload's filename, so the whole product — upload,
# live SSE progress, review queue, duplicate flagging, Excel export — is demoable offline.
# Filename keywords steer it: `...fail...`, `...dup...`, `...blur...`, `...noemail...`.
VLM_PROVIDER=stub

# Point at the real self-hosted Qwen2.5-VL endpoint by setting all three:
#   VLM_PROVIDER=modal
#   VLM_BASE_URL=https://<your-modal-workspace>--ak-project-vlm-serve.modal.run/v1
#   VLM_API_KEY=<bearer key held in the ak-project-vlm-auth Modal secret>
VLM_BASE_URL=
VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
VLM_API_KEY=

# --- Model tuning --------------------------------------------------------------------
# In-flight requests against the endpoint. Measured warm throughput at 6 is
# 0.50-0.67 images/s (100-133 output tokens/s) on one L4.
VLM_CONCURRENCY=6
# MUST stay >= 300 against the real endpoint. The GPU scales to zero and a cold boot
# measures 187-237 s (median ~210 s), so anything shorter fails every first request
# after an idle period.
VLM_TIMEOUT_S=420
# Used until the first successful call: worst-case cold boot plus one inference.
VLM_COLD_TIMEOUT_S=420

# --- Extraction tuning ---------------------------------------------------------------
# Overall confidence below this sends a lead to the review queue (status=needs_review).
CONFIDENCE_THRESHOLD=0.65
# rapidfuzz token-set ratio over "first last company" above which two cards are the
# same lead.
DUPLICATE_FUZZY_THRESHOLD=90
MAX_FILES_PER_BATCH=25
MAX_FILE_MB=12
# Fallback region for phone numbers printed with no country code on a card whose address
# gives no usable hint.
DEFAULT_PHONE_REGION=US

# --- Service -------------------------------------------------------------------------
LOG_LEVEL=INFO
# The dev stack serves the UI on :3000 and the API on :8000, which are different origins.
# Behind the production reverse proxy both are same-origin and this can be tightened.
CORS_ORIGINS=*
# Browser-visible API base; inlined into the Next.js bundle at build time.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# 1 runs the frontend against its own in-process mock backend, with no API container at all.
NEXT_PUBLIC_MOCK=0

# --- Storage -------------------------------------------------------------------------
# The SQLite database and the uploaded card images live in the `leadforge-data` named
# volume, which survives `docker compose down` and is removed by `docker compose down -v`.
# If you swap that for a ./data bind mount (see docker-compose.yml), the container also
# has to run as you on Linux; `make up` exports these from `id -u` / `id -g`.
# LEADFORGE_UID=1000
# LEADFORGE_GID=1000
