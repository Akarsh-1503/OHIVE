# Driftless — developer stack configuration.
#
# Everything here has a working default, so `docker compose up --build` runs with NO .env
# at all. Copy this file to `.env` only when you want to change something:
#
#   cp .env.example .env
#
# `.env` is git-ignored. This application has no model endpoint, no third-party API and no
# credential of any kind, so there is genuinely no secret to leak — but the rule still
# holds: the repository names variables, never values.

# --- Ports -----------------------------------------------------------------------------
# Change these if 3000/8000 are taken. NEXT_PUBLIC_API_BASE below follows API_PORT.
WEB_PORT=3000
API_PORT=8000

# --- SLAM engine -----------------------------------------------------------------------
# stub | real
#
# `stub` is the default so that one command gives a reviewer a working product with no
# expectations attached. It synthesises a reconstruction — camera on a rising helix, ~6 000
# points on a cylindrical shell and floor plane, colours sampled from the real clip — with
# contract-shaped metrics and realistically paced progress events. Every part of the
# product is exercised: upload validation, queueing, the SSE stream, the WebGL viewer, the
# metrics panel, the PLY/TUM/report.json exports. The entire backend test suite runs on it.
# Its metrics are SYNTHETIC and must never be read as measurements.
#
# `real` runs the `slam` package that is already baked into the API image: ORB tracking,
# local bundle adjustment, BoW loop detection and Sim(3) pose-graph optimisation. Its only
# runtime dependencies are numpy, opencv-python-headless and scipy — no GPU, no native
# build, no model download. Every drift and timing claim in this submission is measured
# with `real`:
#
#   SLAM_BACKEND=real docker compose up --build
#
# `GET /api/v1/health` echoes `slam_backend`, so which engine is running is never ambiguous.
SLAM_BACKEND=stub

# --- Engine tuning ---------------------------------------------------------------------
# Frames are downscaled to this width before tracking. 640 is the measured sweet spot: ORB
# cost scales with pixel count, but 480 is *slower* end to end on two of the three clips,
# because a coarser image changes the keyframe policy, the map gets denser and bundle
# adjustment grows faster than feature extraction shrinks.
SLAM_TARGET_WIDTH=640
# ORB keypoints per frame, spread over an 8x6 grid so PnP stays well conditioned.
SLAM_MAX_FEATURES=1200
# Hard frame cap, so a 10-minute upload cannot wedge a worker. Longer clips are accepted,
# capped, and flagged `truncated: true` in the Job payload.
SLAM_MAX_FRAMES=1800
# Intra-job worker threads handed to the engine. Decode and ORB extraction run on their own
# threads (OpenCV releases the GIL) and are hidden behind tracking.
SLAM_WORKERS=4

# Size of the ProcessPoolExecutor. KEEP AT 1. A second concurrent reconstruction roughly
# halves single-job throughput on an 8-vCPU host, which would invalidate the published
# 10 s-per-10 s benchmark. Extra jobs queue in FIFO order and report `queue_position`, and
# the UI surfaces that number rather than implying the job has stalled.
SLAM_MAX_CONCURRENT_JOBS=1

# Point budget for the browser payload. The full cloud is always available through
# GET /api/v1/jobs/{id}/export/ply.
SLAM_MAX_POINTS_WEB=60000

# Pacing of the stub backend's synthetic run, in seconds. Only used when SLAM_BACKEND=stub.
SLAM_STUB_DURATION_S=1.2

# --- Upload limits ---------------------------------------------------------------------
# Enforced before a job id is issued. The upload is streamed to disk and must decode at
# least one frame, or it is rejected with UNDECODABLE_VIDEO and leaves nothing behind.
MAX_UPLOAD_MB=200
MAX_VIDEO_DURATION_S=60

# --- Storage ---------------------------------------------------------------------------
# Artefacts live in the `driftless-data` named volume, which survives `docker compose down`
# and is removed by `docker compose down -v`. See docker-compose.yml for why it is a named
# volume and not a ./data bind mount, and for how to swap it if you want the PLY files on
# the host. To copy one out without swapping:
#
#   docker compose cp api:/data/<job_id>/cloud.ply ./cloud.ply
#
# Job directories older than this are deleted by the janitor so the demo box never fills
# up. Time-based only — there is no disk-pressure trigger.
JOB_TTL_HOURS=24

# If you do switch to a ./data bind mount, `make up` exports these from `id -u` / `id -g`
# so the container can write to a directory you own. Not used by the named-volume default.
# DRIFTLESS_UID=1000
# DRIFTLESS_GID=1000

# --- Service ---------------------------------------------------------------------------
# Comma-separated origins, or * for any. The dev stack is cross-origin (:3000 -> :8000);
# behind the production reverse proxy both are same-origin and this can be tightened.
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Frontend --------------------------------------------------------------------------
# Browser-visible API base. NEXT_PUBLIC_* is inlined into the client bundle at BUILD time,
# so changing it requires a rebuild (`docker compose up --build`). In production it is the
# relative `/api/v1`, because Caddy serves the UI and the API from one origin.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# 1 runs the frontend against its own in-browser mock backend, with no API container at
# all — synthetic reconstruction, faked SSE stream, working 3D viewer and exports.
NEXT_PUBLIC_MOCK=0
