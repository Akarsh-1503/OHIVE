# Base URL of the LeadForge API. Same-origin behind the reverse proxy in production.
NEXT_PUBLIC_API_BASE=/api/v1

# Set to 1 to run entirely against the bundled in-process mock (no backend needed).
# The mock serves the exact shapes in _contracts/assignment1-api.md from /mock/v1 and
# streams real SSE with staggered timings.
NEXT_PUBLIC_MOCK=0
