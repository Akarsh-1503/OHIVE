# Driftless backend — copy to .env and adjust. Never commit real values.

# Where uploads, reconstructions and exports live. Mounted volume in the container.
DATA_DIR=/data

# SLAM engine selection.
#   real -> import the `slam` package from assignment2/slam (default)
#   stub -> synthetic reconstruction, no engine required. Used by the test suite and demos.
SLAM_BACKEND=real

# Engine tuning, forwarded to SlamConfig.
SLAM_TARGET_WIDTH=640
SLAM_MAX_FEATURES=1200
SLAM_MAX_FRAMES=1800
SLAM_WORKERS=4

# Size of the ProcessPoolExecutor. Keep at 1 on an 8-vCPU host: a second concurrent
# reconstruction roughly halves single-job throughput and invalidates the published
# benchmark. Extra jobs queue and report their queue_position.
SLAM_MAX_CONCURRENT_JOBS=1

# Point budget for the web payload. The full cloud is always available via /export/ply.
SLAM_MAX_POINTS_WEB=60000

# Pacing of the stub backend's synthetic run, seconds. Only used when SLAM_BACKEND=stub.
SLAM_STUB_DURATION_S=1.2

# Upload limits, enforced before a job id is issued.
MAX_UPLOAD_MB=200
MAX_VIDEO_DURATION_S=60

# Janitor: job directories older than this are deleted so the demo box never fills up.
JOB_TTL_HOURS=24

# Built-in demo clips. Read-only mount is supported.
SAMPLES_DIR=/samples

# Comma-separated origins, or * for any.
CORS_ORIGINS=*

# Server bind and log verbosity.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
