# LeadForge backend — copy to .env and fill in. Never commit real values.

# --- VLM endpoint -----------------------------------------------------------
# modal | openai_compatible | stub
# `stub` needs no GPU and no network: the whole app runs and the tests pass offline.
VLM_PROVIDER=stub
VLM_BASE_URL=https://<workspace>--ak-project-vlm-serve.modal.run/v1
VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
VLM_API_KEY=
# Unused against the current deployment: auth is the bearer VLM_API_KEY alone. Kept because
# the client still sends them as Modal-Key / Modal-Secret if a future endpoint needs them.
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# --- VLM tuning -------------------------------------------------------------
# Measured warm throughput is ~0.5-0.67 images/s at this concurrency.
VLM_CONCURRENCY=6
# MUST be >= 300. The GPU scales to zero and a cold boot has been measured at 205-301 s,
# so a shorter timeout fails the first request after an idle period. 420 leaves margin.
# Keep this in step with the compose files: a compose default overrides the app default.
VLM_TIMEOUT_S=420
# Used until the endpoint is warm: worst-case cold boot plus one inference, with headroom.
VLM_COLD_TIMEOUT_S=420
VLM_MAX_RETRIES=3
# Exponential backoff base; delay = VLM_RETRY_BASE_S * 2**attempt, with full jitter.
VLM_RETRY_BASE_S=1.5
# Explicit 0: the model's generation_config.json otherwise applies repetition_penalty=1.05.
VLM_TEMPERATURE=0.0
# max_model_len is 4096 and a 1280 px image is ~1280 prompt tokens, so 1024 is the ceiling.
VLM_MAX_TOKENS=1024

# --- Service ----------------------------------------------------------------
DATA_DIR=/data
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Extraction tuning ------------------------------------------------------
# Leads scoring below this land in the review queue (status=needs_review).
CONFIDENCE_THRESHOLD=0.65
# Fuzzy name+company score above which two cards are treated as the same lead.
DUPLICATE_FUZZY_THRESHOLD=90
MAX_FILES_PER_BATCH=25
MAX_FILE_MB=12
# Fallback region for phone numbers printed without a country code.
DEFAULT_PHONE_REGION=US
